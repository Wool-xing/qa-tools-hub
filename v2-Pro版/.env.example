# ==================== QA通关 - 环境变量 ====================
# 复制此文件为 .env 并修改配置

# --- 数据库 ---
# SQLite 默认即可 (单文件), PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/qa_tools.db

# --- 安全 (必改!!) ---
# JWT签名密钥, 生产环境请用随机字符串
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# JWT签名算法 (HS256/RS256/ES256), 默认 HS256
JWT_ALGORITHM=HS256
# Token过期时间, 单位分钟, 默认 1440 (24小时)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 密码最小长度, 默认 8
PASSWORD_MIN_LEN=8

# --- 限流 ---
# 限流窗口 (秒), 默认 60
RATE_LIMIT_WINDOW=60
# 窗口内最大请求数, 默认 5
RATE_LIMIT_MAX=5

# --- 应用基础URL (用于生成密码重置链接等) ---
# 生产环境设为你的公开域名, 如 https://qa.example.com
BASE_URL=

# --- CORS (允许跨域的前端地址) ---
# 多个地址用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:8005,http://localhost:8090

# --- 邮件 (SMTP, 用于密码重置) ---
# 不配置则密码重置功能不可用
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@qatools.local
SMTP_TIMEOUT=10

# --- 沙箱 ---
# 代码沙箱执行超时 (秒), 默认 5
SANDBOX_TIMEOUT=5

# --- 日志 ---
# 日志文件最大字节数, 默认 10485760 (10 MB)
LOG_MAX_BYTES=10485760
# 日志文件保留数量, 默认 5
LOG_BACKUP_COUNT=5

# --- 限制 ---
# XLSX 导入文件大小限制 (字节), 默认 5242880 (5 MB)
MAX_XLSX_BYTES=5242880
# 批量更新测试用例上限, 默认 200
BULK_UPDATE_LIMIT=200
# SQL 沙箱查询结果行数上限, 默认 100
SQL_ROW_LIMIT=100
# 性能模拟最大虚拟用户数, 默认 500
PERF_VUS_MAX=500
# 性能模拟最大时长 (秒), 默认 600
PERF_DURATION_MAX=600
# 管理后台每页默认条数, 默认 50
ADMIN_PAGE_LIMIT=50
# 排行榜展示人数, 默认 10
LEADERBOARD_LIMIT=10
# 技能薄弱判定阈值 (平均分低于此值), 默认 80
SKILL_GAP_WEAK_THRESHOLD=80
# 技能优势判定阈值 (平均分高于此值), 默认 90
SKILL_GAP_STRONG_THRESHOLD=90

# --- 种子数据 ---
# 初始管理员账号 (默认 qatest)
SEED_ADMIN_USERNAME=qatest
# 初始管理员邮箱
SEED_ADMIN_EMAIL=qatest@qa.local
# 初始管理员密码 (留空则自动生成随机密码, 启动时打印到控制台)
SEED_ADMIN_PASSWORD=

# --- 备份 ---
# 备份保留数量, 默认 14
BACKUP_KEEP_LAST=14

# --- 安全头 ---
# HSTS max-age (秒), 默认 1 年
HSTS_MAX_AGE=31536000
# Content-Security-Policy
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'

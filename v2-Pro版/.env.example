# ==================== QA通关 - 环境变量 ====================
# 复制此文件为 .env 并修改配置

# --- 数据库 ---
# SQLite 默认即可 (单文件)
DATABASE_URL=sqlite+aiosqlite:///./qa_tools.db

# --- 安全 (必改!!) ---
# JWT签名密钥, 生产环境请用随机字符串 (openssl rand -hex 32)
SECRET_KEY=change-me-in-production
# Token过期时间, 单位分钟, 默认 1440 (24小时)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (允许跨域的前端地址) ---
# 多个地址用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:8005,http://localhost:8090

# --- 邮件 (SMTP, 用于密码重置) ---
# 不配置则密码重置功能不可用
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@qatools.local

# --- 安全头 ---
# HSTS max-age (秒), 默认 1 年
HSTS_MAX_AGE=31536000
# Content-Security-Policy
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'
